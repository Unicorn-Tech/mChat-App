PORT=3000
NODE_ENV=development
DB_URI=mongodb://localhost:27017/mchat-app

# Comma-separated allowed origins, or leave unset for any (not recommended in prod)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

JWT_SECRET=change-me
JWT_EXPIRY=1h
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRY=7d
JWT_RESET_SECRET=change-me
JWT_RESET_EXPIRY=1h
JWT_VERIFY_SECRET=change-me
JWT_VERIFY_EXPIRY=1h